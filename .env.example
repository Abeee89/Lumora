# Local development. Never commit a filled copy.
DATABASE_URL=postgresql://lumora:lumora@localhost:5432/lumora
LOG_LEVEL=info

# Exact origin of the app. The CSRF check compares it byte for byte.
APP_ORIGIN=http://localhost:3000
# Number of proxy hops the platform adds in front of the app.
TRUSTED_PROXY_HOPS=0
# Set to true on HTTPS: cookies become Secure and use the __Host- name.
SESSION_COOKIE_SECURE=false
# Reset and verification email. Without a provider the message is written to
# EMAIL_SINK_DIR instead of being sent, so the reset link never reaches the log.
EMAIL_SINK_DIR=.artifacts/emails
# Optional. Google sign-in reports "not available" while these are unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google